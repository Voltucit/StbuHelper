<resources>
    <string name="widget_next_course">下一节课</string>
    <string name="widget_pending_homework">未完成作业</string>
    <string name="widget_preview_course_name">高等数学</string>
    <string name="widget_preview_course_detail">10:20 · 教一楼 A204</string>
    <string name="widget_preview_homework_name">高数习题 4</string>
    <string name="widget_preview_homework_detail">23:59 截止 · 高等数学</string>
    <string name="widget_preview_homework_count">3 项</string>
    <color name="campus_widget_surface">#F7F8F5</color>
    <color name="campus_widget_ink">#18271F</color>
    <color name="campus_widget_accent">#1D523D</color>

    <style name="CampusWidgetPreviewStrip">
        <item name="android:background">@drawable/campus_widget_bg</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>
    <style name="CampusWidgetPreviewText">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/campus_widget_ink</item>
    </style>
    <style name="CampusWidgetPreviewName" parent="CampusWidgetPreviewText">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="CampusWidgetPreviewLabel" parent="CampusWidgetPreviewText">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/campus_widget_accent</item>
    </style>
</resources>
